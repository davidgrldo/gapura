_check/
.DS_Store

# The console's build output: the image builds it, so only the directory itself (kept present
# by .gitkeep, for the embed to compile against on a fresh clone) belongs in the repository.
web/dist/*
!web/dist/.gitkeep
web/node_modules/

# Development notes: implementation plans, the design spec, and competitor research.
